# ==============================================================================
# CASH APP CRYPTO LIGHTNING GATEWAY - APACHE / CPANEL / VISTAPANEL .HTACCESS
# Compatible with: VistaPanel (InfinityFree, ByetHost), cPanel, Apache 2.4+
# ==============================================================================

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
RewriteEngine On

# ------------------------------------------------------------------------------
# 1. API ROUTING: Forward all /api/* requests to api/index.php
# ------------------------------------------------------------------------------
RewriteRule ^api/(.*)$ api/index.php [QSA,L]
RewriteRule ^api$ api/index.php [QSA,L]

# ------------------------------------------------------------------------------
# 2. CLEAN PAGE ROUTES: Clean URLs without .html
# ------------------------------------------------------------------------------
# Normalize /pay/:slug -> pay.html
RewriteRule ^pay/([^/]+)/?$ pay.html [QSA,L]
RewriteRule ^pay/?$ pay.html [QSA,L]

# Clean page paths
RewriteRule ^admin/?$ admin.html [QSA,L]
RewriteRule ^owner/?$ admin.html [QSA,L]
RewriteRule ^profile/?$ profile.html [QSA,L]
RewriteRule ^dashboard/?$ admin.html [QSA,L]
RewriteRule ^signup/?$ signup.html [QSA,L]
RewriteRule ^register/?$ signup.html [QSA,L]
RewriteRule ^login/?$ login.html [QSA,L]
RewriteRule ^terms/?$ terms.html [QSA,L]

# ------------------------------------------------------------------------------
# 3. AUTO-APPEND .HTML IF FILE EXISTS
# ------------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# ------------------------------------------------------------------------------
# 4. SECURITY: Deny access to sensitive files
# ------------------------------------------------------------------------------
<FilesMatch "(\.json|\.lock|\.env|\.git|\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 5. DEFAULT DIRECTORY INDEX
# ------------------------------------------------------------------------------
DirectoryIndex index.html index.php

